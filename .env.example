# Dành cho PHÍA AGENT (client/board_client.py) — không phải cho Worker.
# Worker lấy secret từ `wrangler secret put`, không đọc file này.
#
# Copy thành `.env` (đã gitignored) rồi điền:

# URL board đã deploy.
BOARD_API_URL=https://<ten-worker>.<subdomain>.workers.dev

# Đúng giá trị bạn đã đặt bằng `wrangler secret put API_TOKEN`.
BOARD_API_TOKEN=
